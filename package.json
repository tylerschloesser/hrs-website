{
  "name": "@hrs-website/root",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @hrs-website/app dev",
    "build": "pnpm --filter @hrs-website/app build",
    "preview": "pnpm --filter @hrs-website/app preview",
    "check": "prettier --check . && pnpm --filter @hrs-website/app check && tsc -b packages/cdk && pnpm --filter @hrs-website/cdk test",
    "format": "prettier --write .",
    "deploy": "pnpm --filter @hrs-website/cdk deploy",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3"
  }
}
