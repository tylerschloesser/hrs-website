---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Member {
  name: string
  role: string
  email: string
}

interface Props {
  members: Member[]
  photo: ImageMetadata
  photoCaption: string
}

const { members, photo, photoCaption } = Astro.props
---

<section class="bg-surface-alt">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 id="contact" class="text-3xl font-semibold">Contacts</h2>

    <div class="mt-6 grid gap-8 md:grid-cols-2">
      <ul class="space-y-6">
        {
          members.map((member) => (
            <li>
              <h3 class="text-xl font-semibold">{member.name}</h3>
              <p class="text-muted">{member.role}</p>
              <a
                href={`mailto:${member.email}`}
                class="text-primary underline underline-offset-2 hover:text-primary-strong"
              >
                {member.email}
              </a>
            </li>
          ))
        }
      </ul>

      <figure>
        <Image
          src={photo}
          alt={photoCaption}
          width={600}
          loading="lazy"
          class="w-full rounded"
        />
        <figcaption class="mt-2 text-sm text-muted">
          {photoCaption}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
