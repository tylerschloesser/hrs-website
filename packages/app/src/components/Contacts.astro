---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import { faEnvelope } from '@fortawesome/pro-solid-svg-icons'
import Icon from './Icon.astro'

interface Member {
  name: string
  role: string
  email: string
}

interface Props {
  members: Member[]
  photo: ImageMetadata
  photoCaption: string
}

const { members, photo, photoCaption } = Astro.props
---

<section class="band bg-surface-alt">
  <div class="shell">
    <header>
      <h2 id="contact" class="text-3xl font-semibold sm:text-4xl">Contacts</h2>
      <span class="rule"></span>
    </header>

    <div class="mt-10 grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
      <ul class="space-y-4">
        {
          members.map((member) => (
            <li class="rounded-xl border border-border bg-surface p-5 sm:p-6">
              <h3 class="text-xl font-semibold">{member.name}</h3>
              <p class="mt-1 text-sm text-muted">{member.role}</p>
              <a
                href={`mailto:${member.email}`}
                class="mt-3 inline-flex items-center gap-2 text-primary hover:text-primary-strong break-all"
              >
                <Icon icon={faEnvelope} />
                {member.email}
              </a>
            </li>
          ))
        }
      </ul>

      <figure>
        <Image
          src={photo}
          alt=""
          widths={[400, 600, 900]}
          sizes="(min-width: 1024px) 32rem, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
          loading="lazy"
          class="w-full rounded-xl"
        />
        <figcaption class="mt-3 text-sm text-muted">
          {photoCaption}
        </figcaption>
      </figure>
    </div>
  </div>
</section>
