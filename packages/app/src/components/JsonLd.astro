---
// schema.org structured data for the home page: an `@graph` of the NGO and
// the WebSite it publishes (the WebSite node is what Google's site-name
// feature reads). Most values are read from content (site.yml /
// contacts.yml) so an editor updating the CMS keeps this in sync
// automatically; `alternateName`, `areaServed`, `foundingDate` and
// `nonprofitStatus` below are hard-coded facts about the org that the CMS
// has no field for.
import { getImage } from 'astro:assets'
import { getSingleton } from '../lib/content'

const site = await getSingleton('site')
const contacts = await getSingleton('contacts')

const OG_IMAGE_WIDTH = 1200
const OG_IMAGE_HEIGHT = 630

// Same generated social image as Seo.astro (getImage is cached by Astro's
// asset pipeline, so this doesn't re-encode it).
const ogImage = await getImage({
  src: site.og_image,
  width: OG_IMAGE_WIDTH,
  height: OG_IMAGE_HEIGHT,
  fit: 'cover',
  format: 'jpg',
})
const imageUrl = new URL(ogImage.src, Astro.site).toString()

// The 180x180 apple-touch icon rather than favicon.svg: Google's logo
// guidelines want a raster image it can crawl and index.
const logoUrl = new URL('/apple-touch-icon.png', Astro.site).toString()

const orgId = new URL('#org', Astro.site).toString()
const websiteId = new URL('#website', Astro.site).toString()

// contacts.members has at least one entry (content.config.ts enforces
// `min(1)`), so this always resolves — either the President or, failing
// that, the first member.
const president =
  contacts.members.find((m) => m.role === 'President') ?? contacts.members[0]!

// site.donate.mail.city_state_zip is expected to be "City, ST 12345", but
// it's free-form CMS text with no structure the schema enforces. Parse it
// defensively and omit whichever address sub-fields don't parse, rather than
// throwing at build time (no comma) or shipping a bad value (comma, no
// space) into the JSON-LD.
const [addressLocality, regionZip] = site.donate.mail.city_state_zip
  .split(',')
  .map((s) => s.trim())
const [addressRegion, postalCode] = regionZip ? regionZip.split(/\s+/) : []

const org = {
  '@type': 'NGO',
  '@id': orgId,
  name: site.name,
  alternateName: 'HRS',
  description: site.description,
  url: Astro.site,
  logo: logoUrl,
  image: imageUrl,
  email: president.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.donate.mail.street,
    ...(addressLocality && { addressLocality }),
    ...(addressRegion && { addressRegion }),
    ...(postalCode && { postalCode }),
  },
  areaServed: { '@type': 'Place', name: 'Ganthier, Haiti' },
  foundingDate: '1997',
  nonprofitStatus: 'Nonprofit501c3',
}

const website = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: site.name,
  alternateName: 'HRS',
  url: Astro.site,
  publisher: { '@id': orgId },
}

const data = {
  '@context': 'https://schema.org',
  '@graph': [org, website],
}
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />
