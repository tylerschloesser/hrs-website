---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Markdown from './Markdown.astro'

interface Video {
  label: string
  url: string
}

interface Props {
  heading: string
  body: string
  videos: Video[]
  closing: string
  image: ImageMetadata
  imageAlt: string
}

const { heading, body, videos, closing, image, imageAlt } = Astro.props
---

<section class="bg-surface-alt">
  <div class="mx-auto max-w-5xl px-4 py-12">
    <h2 id="events" class="text-3xl font-semibold">Events</h2>

    <div class="mt-6 grid gap-8 md:grid-cols-[3fr_2fr] md:items-start">
      <div class="space-y-4">
        <h3 class="text-2xl font-semibold">{heading}</h3>
        <Markdown content={body} />
        <ul class="list-disc space-y-1 pl-6">
          {
            videos.map((video) => (
              <li>
                <a
                  href={video.url}
                  class="text-primary underline underline-offset-2 hover:text-primary-strong"
                >
                  {video.label}
                </a>
              </li>
            ))
          }
        </ul>
        <p>{closing}</p>
      </div>

      <Image
        src={image}
        alt={imageAlt}
        width={600}
        loading="lazy"
        class="w-full rounded"
      />
    </div>
  </div>
</section>
