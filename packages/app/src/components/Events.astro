---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Markdown from './Markdown.astro'

import { faYoutube } from '@fortawesome/free-brands-svg-icons'
import { faArrowUpRightFromSquare } from '@fortawesome/pro-solid-svg-icons'
import Icon from './Icon.astro'

interface Video {
  label: string
  url: string
}

interface Props {
  heading: string
  body: string
  videos: Video[]
  closing: string
  image: ImageMetadata
  imageAlt: string
}

const { heading, body, videos, closing, image, imageAlt } = Astro.props
---

<section class="band bg-surface">
  <div class="shell">
    <header>
      <h2 id="events" class="text-3xl font-semibold sm:text-4xl">Events</h2>
      <span class="rule"></span>
    </header>

    <div
      class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] lg:items-start lg:gap-12"
    >
      <div class="space-y-6">
        <h3 class="text-xl font-semibold sm:text-2xl">{heading}</h3>
        <Markdown content={body} />

        <ul class="space-y-3">
          {
            videos.map((video) => (
              <li>
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-3 rounded-lg border border-border px-4 py-3 hover:border-primary hover:bg-surface-alt"
                >
                  <Icon icon={faYoutube} />
                  <span class="flex-1">{video.label}</span>
                  <Icon icon={faArrowUpRightFromSquare} class="text-xs" />
                </a>
              </li>
            ))
          }
        </ul>

        <p
          class="mt-8 border-l-2 border-accent pl-5 font-serif text-xl text-ink italic sm:text-2xl"
        >
          {closing}
        </p>
      </div>

      <Image
        src={image}
        alt={imageAlt}
        widths={[400, 600, 900]}
        sizes="(min-width: 1024px) 26rem, 100vw"
        loading="lazy"
        class="w-full rounded-xl lg:sticky lg:top-28"
      />
    </div>
  </div>
</section>
