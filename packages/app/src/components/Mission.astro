---
import Markdown from './Markdown.astro'

interface Props {
  mission: string
  whyHeading: string
  why: string
}

const { mission, whyHeading, why } = Astro.props
---

<section class="bg-surface">
  <div class="mx-auto max-w-5xl space-y-6 px-4 py-12">
    <h2 id="mission-statement" class="text-3xl font-semibold">Our Mission</h2>
    <Markdown content={mission} />
    <h3 class="text-2xl font-semibold">{whyHeading}</h3>
    <Markdown content={why} />
  </div>
</section>
