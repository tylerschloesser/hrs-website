---
import { faGithub } from '@fortawesome/free-brands-svg-icons'
import Icon from './Icon.astro'

interface Props {
  githubUrl: string
}

const { githubUrl } = Astro.props
---

<footer class="bg-brand-dark py-10 text-center text-white">
  <div class="mx-auto max-w-5xl px-4">
    <a
      href={githubUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-2 underline underline-offset-2 hover:text-accent"
    >
      <Icon icon={faGithub} />
      github.com/tylerschloesser
    </a>
  </div>
</footer>
