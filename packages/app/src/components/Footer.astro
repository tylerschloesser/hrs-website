---
import { faGithub } from '@fortawesome/free-brands-svg-icons'
import { faArrowUpRightFromSquare } from '@fortawesome/pro-solid-svg-icons'
import Icon from './Icon.astro'

interface Props {
  siteName: string
  githubUrl: string
}

const { siteName, githubUrl } = Astro.props

// Derived so the visible label always matches where the link actually goes,
// even if an editor points `github_url` at a different account or repo.
const githubLabel = githubUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')
---

<footer class="on-dark border-t border-white/10 bg-brand-dark text-white">
  <div class="shell py-10 sm:py-12">
    <div
      class="flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <p class="font-serif text-lg font-semibold text-white">
        {siteName}
      </p>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-white/70 underline underline-offset-2 transition-colors hover:text-accent"
      >
        <Icon icon={faGithub} />
        {githubLabel}
        <Icon icon={faArrowUpRightFromSquare} class="text-xs" />
      </a>
    </div>
  </div>
</footer>
