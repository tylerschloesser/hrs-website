---
import { faPaypal, faVenmo } from '@fortawesome/free-brands-svg-icons'
import { faEnvelope } from '@fortawesome/pro-solid-svg-icons'
import Icon from './Icon.astro'

interface Mail {
  attn: string
  street: string
  city_state_zip: string
}

interface Props {
  paypalUrl: string
  venmoUrl: string
  mail: Mail
}

const { paypalUrl, venmoUrl, mail } = Astro.props
---

<section class="bg-surface">
  <div class="mx-auto max-w-5xl space-y-6 px-4 py-12">
    <h2 id="donate" class="text-3xl font-semibold">Donate</h2>
    <p>We offer 3 methods for donation:</p>

    <div class="grid gap-6 sm:grid-cols-3">
      <div
        class="flex flex-col items-center gap-4 rounded border border-border p-6 text-center"
      >
        <h3
          class="flex items-center justify-center gap-2 text-lg font-semibold"
        >
          <Icon icon={faPaypal} />
          Donate by PayPal
        </h3>
        <a
          href={paypalUrl}
          class="block w-full rounded bg-primary px-4 py-2 font-medium text-white hover:bg-primary-strong"
        >
          Donate
        </a>
      </div>

      <div
        class="flex flex-col items-center gap-4 rounded border border-border p-6 text-center"
      >
        <h3
          class="flex items-center justify-center gap-2 text-lg font-semibold"
        >
          <Icon icon={faVenmo} />
          Donate by Venmo
        </h3>
        <a
          href={venmoUrl}
          class="block w-full rounded bg-primary px-4 py-2 font-medium text-white hover:bg-primary-strong"
        >
          Donate
        </a>
      </div>

      <div
        class="flex flex-col items-center gap-3 rounded border border-border p-6 text-center"
      >
        <h3
          class="flex items-center justify-center gap-2 text-lg font-semibold"
        >
          <Icon icon={faEnvelope} />
          Donate by Mail
        </h3>
        <p>Kindly mail your tax-deductible contribution to our Treasurer at:</p>
        <address class="w-full rounded bg-surface-alt p-4 text-left not-italic">
          <div>Haitian Relief Services</div>
          <div>Attn: {mail.attn}</div>
          <div>{mail.street}</div>
          <div>{mail.city_state_zip}</div>
        </address>
      </div>
    </div>
  </div>
</section>
