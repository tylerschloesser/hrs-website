---
import { faPaypal, faVenmo } from '@fortawesome/free-brands-svg-icons'
import { faEnvelope } from '@fortawesome/pro-solid-svg-icons'
import Icon from './Icon.astro'

interface Mail {
  attn: string
  street: string
  city_state_zip: string
}

interface Props {
  paypalUrl: string
  venmoUrl: string
  mail: Mail
}

const { paypalUrl, venmoUrl, mail } = Astro.props
---

<section class="band bg-brand-dark on-dark">
  <div class="shell">
    <h2 id="donate" class="text-3xl font-semibold text-white sm:text-4xl">
      Donate
    </h2>
    <span class="rule"></span>
    <p class="mt-6 text-white/80">We offer 3 methods for donation:</p>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      <div
        class="flex flex-col items-center justify-center rounded-xl border border-white/15 bg-white/5 p-6 text-center"
      >
        <Icon icon={faPaypal} class="text-3xl text-accent" />
        <h3 class="mt-4 text-lg font-semibold text-white">Donate by PayPal</h3>
        <a href={paypalUrl} class="btn btn-accent mt-6 w-full"> Donate </a>
      </div>

      <div
        class="flex flex-col items-center justify-center rounded-xl border border-white/15 bg-white/5 p-6 text-center"
      >
        <Icon icon={faVenmo} class="text-4xl text-accent" />
        <h3 class="mt-4 text-lg font-semibold text-white">Donate by Venmo</h3>
        <a href={venmoUrl} class="btn btn-accent mt-6 w-full"> Donate </a>
      </div>

      <div
        class="flex flex-col items-center justify-center rounded-xl border border-white/15 bg-white/5 p-6 text-center"
      >
        <Icon icon={faEnvelope} class="text-3xl text-accent" />
        <h3 class="mt-4 text-lg font-semibold text-white">Donate by Mail</h3>
        <p class="mt-4 text-sm text-white/80">
          Kindly mail your tax-deductible contribution to our Treasurer at:
        </p>
        <address
          class="mt-4 w-full rounded-lg bg-white/10 p-4 text-left text-white not-italic"
        >
          <div>Haitian Relief Services</div>
          <div>Attn: {mail.attn}</div>
          <div>{mail.street}</div>
          <div>{mail.city_state_zip}</div>
        </address>
      </div>
    </div>
  </div>
</section>
