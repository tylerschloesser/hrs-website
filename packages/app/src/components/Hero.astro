---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import Markdown from './Markdown.astro'

interface Props {
  siteName: string
  tagline: string
  heroImage: ImageMetadata
  heroAlt: string
  intro: string
}

const { siteName, tagline, heroImage, heroAlt, intro } = Astro.props
---

<section
  class="on-dark bg-brand-dark pt-12 pb-16 sm:pt-16 sm:pb-20 lg:pt-24 lg:pb-28"
>
  <div class="shell">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:items-center lg:gap-14"
    >
      <div>
        <h1 class="text-4xl font-semibold text-white sm:text-5xl lg:text-6xl">
          {siteName}
        </h1>
        <p class="mt-3 font-sans text-lg font-medium text-accent sm:text-xl">
          {tagline}
        </p>
        <span class="rule"></span>
        <div class="mt-6 max-w-[60ch] text-white/85">
          <Markdown content={intro} />
        </div>
      </div>
      <Image
        src={heroImage}
        alt={heroAlt}
        loading="eager"
        fetchpriority="high"
        widths={[420, 640, 960, 1280]}
        sizes="(min-width: 1024px) 40rem, (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
        class="aspect-[4/3] w-full rounded-xl object-cover ring-1 ring-white/15"
      />
    </div>
  </div>
</section>
