---
import type { ImageMetadata } from 'astro'
import { Image, getImage } from 'astro:assets'

interface GalleryItem {
  image: ImageMetadata
  caption: string
}

interface Props {
  gallery: GalleryItem[]
}

const { gallery } = Astro.props

// Thumbnails are eager-ish small images rendered on the page (`<Image>`
// below); the full-size version is only ever needed once the lightbox
// opens, so it's produced at build time here but attached to the button as
// data attributes rather than an `<img src>` the browser would fetch now.
const items = await Promise.all(
  gallery.map(async (item) => {
    const full = await getImage({
      src: item.image,
      widths: [800, 1200, 1600, 2048],
      format: 'webp',
    })
    return { ...item, full }
  })
)
---

<div class="gallery grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
  {
    items.map((item) => (
      <button
        type="button"
        class="block overflow-hidden rounded border border-border"
        aria-label={item.caption}
        data-full-src={item.full.src}
        data-full-srcset={item.full.srcSet.attribute}
        data-caption={item.caption}
      >
        <Image
          src={item.image}
          width={400}
          alt={item.caption}
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </button>
    ))
  }
</div>
