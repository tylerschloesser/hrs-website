---
// Head-fragment component: title, description, canonical, theme-color, and
// the full Open Graph / Twitter card set. The OG image is generated here
// (not passed in) from `site.og_image`, at the fixed 1200x630 social size.
//
// JPEG rather than WebP: some social scrapers still refuse WebP previews.
// `concert.astro` needs the same shape for its own (different) share image
// and duplicates this rather than importing it, since it deliberately does
// not use Base/Seo at all — see the comment at the top of concert.astro.
import { getImage } from 'astro:assets'
import { getSingleton } from '../lib/content'

interface Props {
  title: string
  description?: string
  /** Set true on utility pages (e.g. 404) that should stay out of search. */
  noindex?: boolean
}

const { title, description, noindex } = Astro.props

const site = await getSingleton('site')
const metaDescription = description ?? site.description

const OG_IMAGE_WIDTH = 1200
const OG_IMAGE_HEIGHT = 630

const ogImage = await getImage({
  src: site.og_image,
  width: OG_IMAGE_WIDTH,
  height: OG_IMAGE_HEIGHT,
  fit: 'cover',
  format: 'jpg',
})
const ogImageUrl = new URL(ogImage.src, Astro.site).toString()

// Girls at the Ganthier school, arm in arm and laughing on a covered
// walkway, several wearing pillowcase dresses and blue hair ribbons.
const OG_IMAGE_ALT =
  'A group of smiling Haitian schoolgirls, several in handmade pillowcase dresses, standing arm in arm outside a coral-colored school building.'

// `build.format: 'file'` means the index page's own URL is `/index.html`
// (that's what keeps `/concert.html` etc. working), so `Astro.url.pathname`
// on the home page is literally `/index.html` — not the `/` anyone actually
// visits or links to. Strip a trailing `index.html` back to `/` so the
// canonical and og:url are the real, shareable URL. Any other `.html` path
// (e.g. `/concert.html`) is left untouched — it *is* the visited URL.
const canonicalPath = Astro.url.pathname.replace(/index\.html$/, '')
const canonicalUrl = new URL(canonicalPath, Astro.site)
---

<title>{title}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonicalUrl} />
<meta name="theme-color" content="#172554" />
{noindex && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={ogImageUrl} />
