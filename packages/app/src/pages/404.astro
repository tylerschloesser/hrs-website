---
import Base from '../layouts/Base.astro'
---

<Base title="Page not found" noindex>
  <main
    class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center"
  >
    <h1 class="text-4xl font-semibold">Page not found</h1>
    <p class="text-body">
      Sorry, we couldn't find the page you were looking for.
    </p>
    <a
      href="/"
      class="font-medium text-primary underline underline-offset-4 hover:text-primary-strong"
    >
      Back to home
    </a>
  </main>
</Base>
